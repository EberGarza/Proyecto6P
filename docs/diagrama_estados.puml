@startuml diagrama_estados
' ============================================================
'  VirtualPet - Diagrama de estados de la mascota
'  Refleja las transiciones implementadas en src/Estados.cpp
' ============================================================

title Diagrama de estados de la mascota

[*] --> Normal

state Normal {
  Normal : entrada / "esta tranquila"
}

state Feliz {
  Feliz : felicidad > 80
}

state Hambrienta {
  Hambrienta : saciedad < 20
  Hambrienta : do / felicidad -= 0.12/s
}

state Cansada {
  Cansada : energia < 20
}

state Durmiendo {
  Durmiendo : entrada / energia +4/s, higiene 0/s
  Durmiendo : do / salud +0.25/s
  Durmiendo : salida / restaurar tasas base
  Durmiendo : no acepta interacciones
}

state Enferma {
  Enferma : salud < 30
  Enferma : do / felicidad -= 0.20/s
}

state Jugando {
  Jugando : temporizador de 5 s
  Jugando : do / energia -1.2/s, higiene -0.9/s
  Jugando : el animo lo sube la actividad, no el estado
}

state Muerta {
  Muerta : estado terminal
  Muerta : entrada / se congelan las tasas
}

' --- Transiciones por necesidades (prioridad: salud > hambre > energia) ---
Normal      --> Feliz       : felicidad > 80
Feliz       --> Normal      : felicidad < 60
Normal      --> Hambrienta  : saciedad < 20
Feliz       --> Hambrienta  : saciedad < 20
Hambrienta  --> Normal      : saciedad > 40
Normal      --> Cansada     : energia < 20
Feliz       --> Cansada     : energia < 20
Cansada     --> Normal      : energia > 35
Cansada     --> Hambrienta  : saciedad < 20

' --- Sueno ---
Normal      --> Durmiendo   : dormir()
Feliz       --> Durmiendo   : dormir()
Cansada     --> Durmiendo   : dormir(), o solo al llegar a energia = 0
Durmiendo   --> Normal      : despertar() o energia = 100

' --- Enfermedad ---
Normal      --> Enferma     : salud < 30
Feliz       --> Enferma     : salud < 30
Hambrienta  --> Enferma     : salud < 30
Cansada     --> Enferma     : salud < 30
Enferma     --> Normal      : salud > 50

' --- Juego ---
Normal      --> Jugando     : jugar()
Feliz       --> Jugando     : jugar()
Jugando     --> Feliz       : fin del temporizador
Jugando     --> Hambrienta  : fin del temporizador / saciedad < 20
Jugando     --> Cansada     : fin del temporizador / energia < 20

' --- Muerte ---
Normal      --> Muerta      : salud = 0
Feliz       --> Muerta      : salud = 0
Hambrienta  --> Muerta      : salud = 0
Cansada     --> Muerta      : salud = 0
Durmiendo   --> Muerta      : salud = 0
Enferma     --> Muerta      : salud = 0
Jugando     --> Muerta      : salud = 0

Muerta --> [*]

note right of Muerta
  La salud no baja sola: baja cuando
  saciedad < 15, higiene < 20 o
  felicidad < 10 (ver
  Mascota::aplicarEfectosSecundarios).
end note

note as ActividadNota
  **Las acciones ocupan a la mascota**

  Aparte del estado, la mascota puede estar
  haciendo algo: comiendo, jugando, banandose
  o curandose. Mientras dure, **no acepta
  ninguna otra accion**: Mascota::puede() las
  rechaza todas y la botonera se apaga.

  Dormir y jugar son las dos que ademas
  cambian de estado; comer y banarse ocurren
  sin salir del estado en que este.
end note

@enduml
