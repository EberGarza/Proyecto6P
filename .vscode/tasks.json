{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compilar el juego",
            "type": "shell",
            "command": "mingw32-make",
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Compilar y ejecutar",
            "type": "shell",
            "command": "mingw32-make run",
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Banco de pruebas (sin SFML)",
            "type": "shell",
            "command": "mingw32-make consola",
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Revisar hoja de sprites",
            "type": "shell",
            "command": "mingw32-make hoja",
            "problemMatcher": ["$gcc"]
        }
    ]
}
